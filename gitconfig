# vim: ft=gitconfig

[init]
  defaultBranch = main
  templatedir = ~/.git_template
[push]
  default = current
[color]
  ui = auto
[alias]
  aa = add --all
  ap = add --patch
  branches = "for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes"
  ci = commit -v
  co = checkout
  pf = push --force-with-lease
  st = status
  dv = !nvim -c "DiffviewOpen"
  lol = log --pretty=oneline --abbrev-commit --graph --decorate
  lg = log -p
  lo = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(green)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  br = branch
  df = diff
  fa = fetch --prune --all
[include]
  path = ~/.gitconfig.local

[core]
  excludesfile = ~/.gitignore
  autocrlf = input
[merge]
  ff = only
[commit]
  template = ~/.gitmessage
[fetch]
  prune = true
[rebase]
  autosquash = true
[diff]
  colorMoved = zebra
[pull]
	ff = only

[merge]
    tool = diffview
[mergetool "diffview"]
    # $MERGED is the file with conflict markers
    cmd = nvim -n -c "DiffviewOpen" "$MERGED"
[mergetool]
    prompt = false
    keepBackup = false

[diff]
    tool = diffview
[difftool "diffview"]
    # $LOCAL and $REMOTE are the temporary files Git generates for comparison
    cmd = nvim -c "DiffviewOpen" "$LOCAL" "$REMOTE"
[difftool]
    prompt = false
